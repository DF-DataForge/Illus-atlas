# Example only. Copy locally and replace placeholders; never commit credentials.
NODE_ENV=production
HOST=127.0.0.1
PORT=5000
# Build-time only: set this when running npm run build on your own domain.
# PUBLIC_SITE_URL=https://atlas.example.com

# Odoo configuration is backend-only. The contact label is fixed to verkooppunt.
ODOO_URL=https://illusdemo.data-forge.be
ODOO_DATABASE=illusdemo
ODOO_USERNAME=your-odoo-login@example.com
ODOO_PASSWORD=replace-with-your-odoo-password

# Optional Photon-compatible provider and writable persistent geocoding cache.
GEOCODING_URL=https://photon.komoot.io/api/
GEOCODING_CACHE_FILE=.cache/geocoding.json

# Optional: only required when using the legacy database/BESS endpoints.
# DATABASE_URL=postgresql://atlas:replace-password@127.0.0.1:5432/atlas