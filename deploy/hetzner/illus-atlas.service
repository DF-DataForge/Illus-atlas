[Unit]
Description=Illus-atlas Express web application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=illus-atlas
Group=illus-atlas
WorkingDirectory=/opt/illus-atlas
EnvironmentFile=/etc/illus-atlas.env
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=5000
Environment=GEOCODING_CACHE_FILE=/var/cache/illus-atlas/geocoding.json
ExecStart=/usr/bin/node /opt/illus-atlas/dist/index.cjs
Restart=on-failure
RestartSec=3s
KillSignal=SIGTERM
TimeoutStopSec=30s
UMask=0027

CacheDirectory=illus-atlas
CacheDirectoryMode=0750
ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target